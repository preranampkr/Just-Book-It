# Just Book It — Backend Environment Configuration

# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Identifier
# Recommended: gemini-2.5-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Cloud Service Account Credentials for Cloud STT / TTS
# When left unset, Just Book It automatically uses free browser Web Speech API (SpeechRecognition + speechSynthesis)
# GOOGLE_APPLICATION_CREDENTIALS=

# Server Host and Port
HOST=127.0.0.1
PORT=8000
